def get_official_sources_freshness():
    import sqlite3
    from pathlib import Path
    from datetime import date

    news_db = Path("/opt/newsbot_v2/news_queue.db")
    tariffs_db = Path("/opt/newsbot_v2/data/unified_tariffs.db")

    result = {
        "ozon_status": "bad",
        "ozon_status_label": "Ozon: боевой источник не найден",
        "ozon_reason": "Админка не нашла стандартный официальный файл Ozon для расчётов.",
        "ozon_source_file": None,
        "ozon_source_status": None,
        "ozon_source_role": None,
        "ozon_source_note": None,
        "ozon_valid_from": None,
        "ozon_tariff_age_days": None,
        "ozon_rows": 0,
        "ozon_loaded_at": None,
        "ozon_days_since_loaded": None,
        "ozon_signals_after_source": 0,
        "ozon_last_signal_at": None,
        "ozon_select_note": "не найден / не используется как боевой источник",
        "official_today": [],
        "errors": [],
    }

    # 1. Боевой Ozon-файл и строки комиссий из unified_tariffs.db.
    try:
        con = sqlite3.connect(str(tariffs_db))
        con.row_factory = sqlite3.Row
        cur = con.cursor()

        row = cur.execute("""
            SELECT
                q.source_file,
                q.source_status,
                q.source_role,
                q.source_note,
                q.comment,
                q.created_at AS quality_created_at,
                MAX(c.valid_from) AS valid_from,
                COUNT(c.id) AS rows_count
            FROM tariff_source_quality q
            LEFT JOIN clean_commissions c
              ON c.marketplace = q.marketplace
             AND c.source_file = q.source_file
             AND c.fee_type = 'marketplace_service_rate'
            WHERE q.marketplace = 'ozon'
              AND q.source_status = 'usable'
              AND q.source_role = 'standard_marketplace_service_rate'
            GROUP BY
                q.source_file,
                q.source_status,
                q.source_role,
                q.source_note,
                q.comment,
                q.created_at
            ORDER BY MAX(c.valid_from) DESC, q.created_at DESC
            LIMIT 1
        """).fetchone()

        if row:
            result["ozon_source_file"] = row["source_file"]
            result["ozon_source_status"] = row["source_status"]
            result["ozon_source_role"] = row["source_role"]
            result["ozon_source_note"] = row["source_note"] or row["comment"]
            result["ozon_valid_from"] = row["valid_from"]
            result["ozon_rows"] = int(row["rows_count"] or 0)
            result["ozon_tariff_age_days"] = _admin_days_since(row["valid_from"])

        select_row = cur.execute("""
            SELECT COUNT(*) AS cnt
            FROM tariff_source_quality
            WHERE marketplace = 'ozon'
              AND lower(source_file) LIKE '%select%'
        """).fetchone()

        if select_row and int(select_row["cnt"] or 0) > 0:
            result["ozon_select_note"] = "найден в базе, но должен оставаться test_only / не использовать как боевой источник"

        con.close()

    except Exception as e:
        result["errors"].append(f"Ошибка чтения тарифной базы Ozon: {e}")

    # 2. Дата загрузки файла, Ozon-сигналы после загрузки, официальный слой сегодня.
    try:
        con = sqlite3.connect(str(news_db))
        con.row_factory = sqlite3.Row
        cur = con.cursor()

        source_file = result.get("ozon_source_file")

        if source_file and _admin_table_exists(cur, "rules_imported_files"):
            loaded = cur.execute("""
                SELECT MAX(imported_at) AS imported_at
                FROM rules_imported_files
                WHERE file_path LIKE ?
            """, (f"%{source_file}%",)).fetchone()

            if loaded and loaded["imported_at"]:
                result["ozon_loaded_at"] = loaded["imported_at"]
                result["ozon_days_since_loaded"] = _admin_days_since(loaded["imported_at"])

        check_from = result.get("ozon_loaded_at") or result.get("ozon_valid_from")

        if check_from and _admin_table_exists(cur, "tariff_signals"):
            sig = cur.execute("""
                SELECT COUNT(*) AS cnt, MAX(detected_at) AS last_signal_at
                FROM tariff_signals
                WHERE lower(COALESCE(marketplace, '')) = 'ozon'
                  AND detected_at >= ?
            """, (check_from,)).fetchone()

            if sig:
                result["ozon_signals_after_source"] = int(sig["cnt"] or 0)
                result["ozon_last_signal_at"] = sig["last_signal_at"]

        if _admin_table_exists(cur, "rules_documents"):
            today = date.today().strftime("%Y-%m-%d")
            rows = cur.execute("""
                SELECT
                    marketplace,
                    document_name,
                    COUNT(*) AS rows_loaded,
                    COUNT(DISTINCT section) AS sections_loaded,
                    MIN(loaded_at) AS first_loaded,
                    MAX(loaded_at) AS last_loaded,
                    MAX(source_url) AS source_url
                FROM rules_documents
                WHERE substr(loaded_at, 1, 10) = ?
                GROUP BY marketplace, document_name
                ORDER BY rows_loaded DESC
                LIMIT 10
            """, (today,)).fetchall()

            result["official_today"] = [dict(r) for r in rows]

        con.close()

    except Exception as e:
        result["errors"].append(f"Ошибка чтения новостной/официальной базы: {e}")

    # 3. Человеческий статус.
    if result["errors"]:
        result["ozon_status"] = "bad"
        result["ozon_status_label"] = "Ozon: ошибка чтения источников"
        result["ozon_reason"] = "Админка не смогла полностью проверить тарифную или новостную базу."
    elif not result["ozon_source_file"] or result["ozon_rows"] <= 0:
        result["ozon_status"] = "bad"
        result["ozon_status_label"] = "Ozon: боевой файл не найден"
        result["ozon_reason"] = "Нет пригодного standard_marketplace_service_rate-файла Ozon в тарифной базе."
    elif "select" in str(result["ozon_source_file"]).lower():
        result["ozon_status"] = "bad"
        result["ozon_status_label"] = "Ozon: риск использования Select"
        result["ozon_reason"] = "Боевой источник похож на Ozon Select. Для расчётов нужен standard marketplace service rate."
    elif result["ozon_signals_after_source"] > 0:
        result["ozon_status"] = "warn"
        result["ozon_status_label"] = "Ozon: требуется ручная проверка"
        result["ozon_reason"] = (
            "После последней загрузки официального файла Ozon найдены Ozon-сигналы "
            "в новостном/сигнальном мониторе. Это не доказывает изменение тарифа, "
            "но администратору нужно проверить, не вышла ли новая официальная таблица или PDF."
        )
    elif result["ozon_tariff_age_days"] is not None and result["ozon_tariff_age_days"] >= 30:
        result["ozon_status"] = "warn"
        result["ozon_status_label"] = "Ozon: файл действует больше 30 дней"
        result["ozon_reason"] = (
            "Официальный тарифный файл найден, но дата начала действия тарифа уже старая. "
            "Нужно периодически сверять документы Ozon вручную."
        )
    else:
        result["ozon_status"] = "ok"
        result["ozon_status_label"] = "Ozon: источник свежий"
        result["ozon_reason"] = "Боевой файл Ozon найден, Select не используется, новых Ozon-сигналов после загрузки не найдено."

    return result


