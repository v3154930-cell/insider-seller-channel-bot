def _admin_table_exists(cur, table_name):
    row = cur.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name=?",
        (table_name,),
    ).fetchone()
    return row is not None


def _admin_h(value):
    value = "" if value is None else str(value)
    return (
        value
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )



def _admin_h(value):
    import html as _html
    if value is None or str(value).strip() == "":
        return "не указано"
    return _html.escape(str(value))


def _admin_badge(text, status="warn"):
    import html as _html

    colors = {
        "ok": ("#15803d", "#dcfce7", "#bbf7d0"),
        "warn": ("#b45309", "#fef3c7", "#fde68a"),
        "bad": ("#b91c1c", "#fee2e2", "#fecaca"),
    }
    fg, bg, border = colors.get(status, colors["warn"])

    return (
        f"<span style='display:inline-block;padding:6px 10px;"
        f"border-radius:999px;font-weight:700;color:{fg};"
        f"background:{bg};border:1px solid {border};'>"
        f"{_html.escape(str(text))}</span>"
    )


def _admin_days_since(date_value):
    from datetime import datetime, date

    if not date_value:
        return None

    s = str(date_value).strip()
    if not s:
        return None

    # Берём только YYYY-MM-DD, даже если дата пришла как ISO datetime.
    s = s[:10]

    try:
        d = datetime.strptime(s, "%Y-%m-%d").date()
        return (date.today() - d).days
    except Exception:
        return None


