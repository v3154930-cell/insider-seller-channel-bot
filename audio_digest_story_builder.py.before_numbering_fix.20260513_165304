        "сэллер": "сЭллер",

        "Селлеров": "СЭллеров",
        "Селлерам": "СЭллерам",
        "Селлерами": "СЭллерами",
        "Селлера": "СЭллера",
        "Селлеры": "СЭллеры",
        "Селлер": "СЭллер",

        "Сэллеров": "СЭллеров",
